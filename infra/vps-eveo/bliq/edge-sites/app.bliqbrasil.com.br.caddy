# Bliq PRODUÇÃO (~/bliq/prod). Cloudflare: proxied, Origin Rule → 8443, SSL Estrito.
# Copiar para ~/edge/sites/ e dar validate + reload (ver ~/edge/README.md).
app.bliqbrasil.com.br:8443 {
	tls /certs/app.bliqbrasil.com.br/origin.pem /certs/app.bliqbrasil.com.br/origin.key
	import logs

	# Só a Cloudflare (e a própria VPS, para teste) chega na origem. Faixas em
	# https://www.cloudflare.com/ips — as mesmas de BliqBackend/src/shared/http/proxiesConfiaveis.ts.
	@fora not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 private_ranges
	handle @fora {
		respond "Forbidden" 403
	}

	# Mesmas rotas do nginx antigo: /api e /health no backend, o resto no Next.
	@backend path /api /api/* /health
	handle @backend {
		reverse_proxy bliq-prod-backend:3000 {
			# IP real do cliente para o rate limit (o backend confia na rede edge).
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	handle {
		reverse_proxy bliq-prod-web:3002
	}
}
