# Copiar para ~/bliq/<ambiente>/backend.env (chmod 600).
# DATABASE_URL, PORT, LOG_DIR e PROXIES_CONFIAVEIS_EXTRA vêm do compose.

# PRODUÇÃO: tem que ser IDÊNTICO ao do servidor antigo. API_KEY_SECRET e
# CLIENTE_ID_SECRET não estão definidos e são derivados dele — trocar quebra
# as chaves da API v1, os IDs públicos de cliente e os tokens dos totens.
# STAGING: sempre um valor diferente (openssl rand -hex 48), para um token da
# staging nunca valer em produção.
JWT_SECRET=

CORS_ORIGIN=https://staging.bliqbrasil.com.br

ANTHROPIC_API_KEY=
# Staging: limite baixo, a chave é paga. Produção: omitir (padrão 60).
ASSISTENTE_LIMITE_DIARIO=10
